{
  "name": "apex-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "desktopName": "apex-editor.desktop",
  "author": "Apex Editor contributors",
  "description": "Cross-platform Assetto Corsa car and track editor",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage tar.gz",
    "dist:windows": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.apexeditor.app",
    "productName": "Apex Editor",
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "node_modules/three/examples/jsm/curves/NURBSCurve.js", "to": "three-addons/curves/NURBSCurve.js" },
      { "from": "node_modules/three/examples/jsm/curves/NURBSUtils.js", "to": "three-addons/curves/NURBSUtils.js" },
      { "from": "node_modules/three/examples/jsm/libs/fflate.module.js", "to": "three-addons/libs/fflate.module.js" },
      { "from": "node_modules/three/examples/jsm/loaders/FBXLoader.js", "to": "three-addons/loaders/FBXLoader.js" }
    ],
    "icon": "build/icon.png",
    "linux": {
      "category": "Graphics",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
